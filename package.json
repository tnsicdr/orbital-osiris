{
  "name": "orbital-osiris",
  "type": "module",
  "version": "0.0.1",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=12.0.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "test:ci": "vitest run --browser.headless=true",
    "test:watch": "vitest",
    "postinstall": "pnpm exec playwright install"
  },
  "dependencies": {
    "@astrojs/react": "7.1.9",
    "@fontsource-variable/noto-sans-jp": "^5.3.1",
    "@fontsource/line-seed-jp": "^5.3.2",
    "@lucide/astro": "^1.63.0",
    "@nanostores/react": "^2.0.1",
    "astro": "7.4.12",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "nanostores": "^1.5.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "^5.1.0",
    "playwright": "^1.65.1",
    "postcss": "^8.5.32",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-import": "^17.0.1",
    "postcss-nesting": "^14.0.3",
    "postcss-preset-env": "^11.6.1",
    "vitest": "^5.1.0",
    "vitest-browser-react": "^2.3.0"
  }
}
